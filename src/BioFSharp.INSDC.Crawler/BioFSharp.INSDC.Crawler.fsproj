<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Endpoints.fs" />
    <Compile Include="Log.fs" />
    <Compile Include="Internal\Files.fs" />
    <Compile Include="Internal\Http.fs" />
    <Compile Include="CrawlOptions.fs" />
    <Compile Include="Discovery.fs" />
    <Compile Include="Paper.fs" />
    <Compile Include="Dee2.fs" />
    <Compile Include="Crawler.fs" />
    <None Include="..\..\docs\img\icon.png" Pack="true" PackagePath="" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <PropertyGroup>
    <Authors>Kevin Schneider, BioFSharp contributors</Authors>
    <Description>Crawls INSDC (International Nucleotide Sequence Database Collaboration) records from ENA — enumerates every run, experiment, sample, and study connected to a project accession and persists them via the BioFSharp.INSDC.SQLite store.</Description>
    <Summary>ENA crawler for BioFSharp.INSDC entities.</Summary>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/BioFSharp/BioFSharp.INSDC</PackageProjectUrl>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>bioinformatics F# fsharp INSDC ENA SRA crawler BioProject Sample Study Experiment Run</PackageTags>
    <RepositoryUrl>https://github.com/BioFSharp/BioFSharp.INSDC</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BioFSharp.FileFormats.INSDC\BioFSharp.FileFormats.INSDC.csproj" />
    <ProjectReference Include="..\BioFSharp.IO.INSDC\BioFSharp.IO.INSDC.fsproj" />
    <ProjectReference Include="..\BioFSharp.INSDC.SQLite\BioFSharp.INSDC.SQLite.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FsHttp" Version="15.0.3" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.30" />
  </ItemGroup>

</Project>
