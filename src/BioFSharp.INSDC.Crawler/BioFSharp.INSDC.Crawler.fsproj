<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The crawler is a net8.0 dev/inspection tool, NOT a shipped netstandard2.0
    package: it does live HTTP via FsHttp (which requires .NET 6+), so it cannot
    match the netstandard2.0 convention of the shipped libraries. IsPackable is
    false so the `src/**/*.*proj` Pack glob skips it.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Endpoints.fs" />
    <Compile Include="Log.fs" />
    <Compile Include="Internal\Http.fs" />
    <Compile Include="CrawlOptions.fs" />
    <Compile Include="Discovery.fs" />
    <Compile Include="Crawler.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BioFSharp.FileFormats.INSDC\BioFSharp.FileFormats.INSDC.csproj" />
    <ProjectReference Include="..\BioFSharp.IO.INSDC\BioFSharp.IO.INSDC.fsproj" />
    <ProjectReference Include="..\BioFSharp.INSDC.SQLite\BioFSharp.INSDC.SQLite.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FsHttp" Version="15.0.3" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
  </ItemGroup>

</Project>
