<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- Generated code: silence missing-XML-doc and obsolete-API warnings emitted by xscgen output. -->
    <NoWarn>$(NoWarn);CS1591;CS0612;CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\docs\img\icon.png" Pack="true" PackagePath="" />
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
    <!-- XSDs are source-of-truth for the generated types but are not compiled. -->
    <None Include="schemas\**\*.xsd" />
  </ItemGroup>

  <PropertyGroup>
    <Authors>Kevin Schneider, BioFSharp contributors</Authors>
    <Description>Auto-generated C# type model for INSDC (International Nucleotide Sequence Database Collaboration) XML records, used by BioFSharp.IO.INSDC.</Description>
    <Summary>INSDC XML type model for BioFSharp.</Summary>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/BioFSharp/BioFSharp.INSDC</PackageProjectUrl>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>bioinformatics F# fsharp INSDC ENA SRA BioProject Sample Study Experiment Run</PackageTags>
    <RepositoryUrl>https://github.com/BioFSharp/BioFSharp.INSDC</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <FsDocsLicenseLink>https://github.com/BioFSharp/BioFSharp.INSDC/blob/main/LICENSE</FsDocsLicenseLink>
    <FsDocsReleaseNotesLink>https://github.com/BioFSharp/BioFSharp.INSDC/blob/main/RELEASE_NOTES.md</FsDocsReleaseNotesLink>
  </PropertyGroup>

  <ItemGroup>
    <!-- Generated code references System.ComponentModel.DataAnnotations attributes, which need a package reference on netstandard2.0. -->
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
  </ItemGroup>

</Project>
