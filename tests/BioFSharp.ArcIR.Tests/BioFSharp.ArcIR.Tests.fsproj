<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Phase3Fixtures.fs" />
    <Compile Include="CoreTests.fs" />
    <Compile Include="JsonPersistenceTests.fs" />
    <Compile Include="FragmentAddressingTests.fs" />
    <Compile Include="StateArtifactTests.fs" />
    <Compile Include="SchemaTests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="fixtures\arcir\*.arcir.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\BioFSharp.ArcIR\schema\arcir-1.0.schema.json"
          Link="schema\arcir-1.0.schema.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BioFSharp.ArcIR\BioFSharp.ArcIR.fsproj" />
  </ItemGroup>

</Project>
