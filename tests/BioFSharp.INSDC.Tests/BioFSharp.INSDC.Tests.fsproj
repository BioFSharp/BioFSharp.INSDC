<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="TestHelpers.fs" />
    <Compile Include="IOTests.fs" />
    <Compile Include="ArcIRTests.fs" />
    <Compile Include="F1AccountingTests.fs" />
    <Compile Include="SssomMappingTests.fs" />
    <Compile Include="SQLiteTests.fs" />
    <Compile Include="CrawlerTests.fs" />
    <Compile Include="CrawlerHardeningTests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="OBO.NET" Version="0.6.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BioFSharp.ArcIR\BioFSharp.ArcIR.fsproj" />
    <ProjectReference Include="..\..\src\BioFSharp.FileFormats.INSDC\BioFSharp.FileFormats.INSDC.csproj" />
    <ProjectReference Include="..\..\src\BioFSharp.IO.INSDC\BioFSharp.IO.INSDC.fsproj" />
    <ProjectReference Include="..\..\src\BioFSharp.INSDC.ArcIR\BioFSharp.INSDC.ArcIR.fsproj" />
    <ProjectReference Include="..\..\src\BioFSharp.INSDC.SQLite\BioFSharp.INSDC.SQLite.fsproj" />
    <ProjectReference Include="..\..\src\BioFSharp.INSDC.Crawler\BioFSharp.INSDC.Crawler.fsproj" />
  </ItemGroup>

</Project>
