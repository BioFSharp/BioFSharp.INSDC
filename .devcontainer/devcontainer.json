{
  "name": "BioFSharp.INSDC",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "vscode",
  "containerUser": "vscode",
  "workspaceFolder": "/workspaces/BioFSharp.INSDC",
  "mounts": [
    "source=overarc-bashhistory,target=/commandhistory,type=volume",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.claude,target=/home/vscode/.claude,type=bind,consistency=cached"
  ],
  "remoteEnv": {
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "DOTNET_NOLOGO": "1",
    "NODE_OPTIONS": "--max-old-space-size=4096",
    "POWERSHELL_TELEMETRY_OPTOUT": "1", 
    "DATAHUB_TEST_URL": "${localEnv:DATAHUB_TEST_URL}",
    "DATAHUB_TEST_TOKEN": "${localEnv:DATAHUB_TEST_TOKEN}",
    "DATAHUB_TEST_PROJECT": "${localEnv:DATAHUB_TEST_PROJECT}"
  },
  "features": {
    "ghcr.io/devcontainers/features/node:2.0.0": {
      "version": "20"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11",
      "installTools": false
    },
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/va-h/devcontainers-features/uv:1": {}
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "Ionide.Ionide-fsharp",
        "ms-dotnettools.csharp",
        "ms-python.python",
        "charliermarsh.ruff",
        "redhat.vscode-yaml",
        "DavidAnson.vscode-markdownlint",
        "anthropic.claude-code",
        "openai.chatgpt"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "FSharp.useSdkScripts": true
      }
    }
  }
}
