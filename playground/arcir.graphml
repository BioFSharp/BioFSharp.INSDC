    <node id="DRA005154">
      <data key="label">DRA005154</data>
      <data key="kind">Collection</data>
      <data key="dtypes">Submission</data>
      <data key="nd21">Kakutani lab, Department of Integrative Genetics, National Institute of Genetics</data>
